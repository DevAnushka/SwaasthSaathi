# ==========================================
# ArogyaPulse - Medical Care Environment Configuration
# ==========================================

# 1. Google Gemini API Key (Required for AI Prescription Vision OCR & Medical Translation)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Neon Serverless PostgreSQL Database URL
# Create a free database at: https://neon.tech
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# 3. Google Maps JavaScript & Places API Key
# Obtain from Google Cloud Console: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 4. Cloudflare Configuration (Optional, for edge deployment)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# App Environment
NODE_ENV=development
